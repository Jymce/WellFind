# Django core
SECRET_KEY=generate-a-new-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Gmail SMTP (password reset emails)
# Use a Google App Password, NOT your Gmail password:
# https://myaccount.google.com/apppasswords
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password

# PayPal checkout (sandbox)
# Get one at https://developer.paypal.com/dashboard/
PAYPAL_SANDBOX_CLIENT_ID=your-paypal-sandbox-client-id

# Windows only: path to npm for `python manage.py tailwind` commands
#NPM_BIN_PATH=C:\Program Files\nodejs\npm.cmd
